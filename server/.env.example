# Copy this file to server/.env and fill in your own values.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/electrical_material_platform
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_NAME=electrical_platform_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional one-time first-admin setup key. Use a random value of at least 32 characters.
ADMIN_BOOTSTRAP_TOKEN=

# Optional seed values used by npm run seed:admin --prefix server
ADMIN_NAME=Platform Admin
ADMIN_PHONE=9999999999
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-this-with-a-strong-password-of-at-least-12-characters
