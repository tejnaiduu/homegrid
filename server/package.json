{
  "name": "electrical-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run setup:env && npm run check:env",
    "dev": "nodemon src/server.js",
    "prestart": "npm run setup:env && npm run check:env",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "check:env": "node src/scripts/checkEnv.js",
    "setup:env": "node src/scripts/setupLocalEnv.js",
    "test": "node --test test/**/*.test.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:catalog": "node src/scripts/seedCatalog.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9"
  }
}
